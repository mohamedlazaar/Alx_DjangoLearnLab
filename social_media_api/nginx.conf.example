# Example Nginx configuration for use behind a reverse proxy or on a VPS.
# Copy and adjust server_name, paths, and proxy_pass as needed.
# This assumes Gunicorn is bound to 127.0.0.1:8000 (e.g. gunicorn ... --bind 127.0.0.1:8000).

upstream django {
    server 127.0.0.1:8000;
}

server {
    listen 80;
    server_name yourdomain.com www.yourdomain.com;
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    server_name yourdomain.com www.yourdomain.com;

    # SSL certificates (use Let's Encrypt or your provider)
    # ssl_certificate     /etc/ssl/certs/yourdomain.crt;
    # ssl_certificate_key /etc/ssl/private/yourdomain.key;

    client_max_body_size 10M;

    location /static/ {
        alias /path/to/social_media_api/staticfiles/;
    }

    location /media/ {
        alias /path/to/social_media_api/media/;
    }

    location / {
        proxy_pass http://django;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
    }
}
