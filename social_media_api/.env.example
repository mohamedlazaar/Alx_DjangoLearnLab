# Copy to .env and set values. Never commit .env to version control.

# Required in production: use a long random string (e.g. python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SECRET_KEY=your-secret-key-here

# Set to False in production
DJANGO_DEBUG=False

# Comma-separated list of allowed host/domain names (e.g. yourdomain.com,api.herokuapp.com)
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Production database (PostgreSQL). Leave unset for local SQLite.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# Optional: HTTPS and CSRF
SECURE_SSL_REDIRECT=True
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Optional: file logging (ensure project/logs/ exists)
# LOG_TO_FILE=1
# DJANGO_LOG_LEVEL=INFO
